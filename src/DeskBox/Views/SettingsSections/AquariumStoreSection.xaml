<UserControl
    x:Class="DeskBox.Views.SettingsSections.AquariumStoreSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:svc="using:DeskBox.Services">
    <StackPanel Spacing="12">
        <TextBlock FontSize="24" FontWeight="SemiBold" svc:Localized.Key="Aquarium.Settings.Store" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="CoinBalance" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="TransactionsButton" Click="TransactionsButton_Click"
                    MinWidth="0" Padding="10,5" svc:Localized.Key="Aquarium.Settings.Transactions" />
        </StackPanel>
        <toolkit:SettingsCard
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            svc:Localized.HeaderKey="Aquarium.Settings.Store">
            <StackPanel Spacing="8">
                <StackPanel x:Name="StoreCategories" Orientation="Vertical" Spacing="6" />
                <StackPanel x:Name="StoreItems" Spacing="10" />
            </StackPanel>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard
            svc:Localized.HeaderKey="Tree.FruitMarket"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <sections:FruitMarketSection xmlns:sections="using:DeskBox.Views.SettingsSections" />
        </toolkit:SettingsCard>
        <TextBlock x:Name="StoreStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
