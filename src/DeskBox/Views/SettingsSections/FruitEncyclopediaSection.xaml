<UserControl
    x:Class="DeskBox.Views.SettingsSections.FruitEncyclopediaSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:sections="using:DeskBox.Views.SettingsSections">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="4,8,4,20">
            <TextBlock Text="图鉴" FontSize="24" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AquariumTabButton" Content="水族馆图鉴" Click="AquariumTab_Click" />
                <Button x:Name="FruitTabButton" Content="果实图鉴" Click="FruitTab_Click" />
                <Button x:Name="WildlifeTabButton" Content="动物图鉴" Click="WildlifeTab_Click" />
            </StackPanel>
            <StackPanel x:Name="AquariumPanel" Spacing="8">
                <toolkit:WrapPanel x:Name="AquariumCategories" Orientation="Horizontal" HorizontalSpacing="6" VerticalSpacing="6" />
                <GridView x:Name="AquariumItems" Height="400" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemTemplate><DataTemplate x:DataType="sections:AtlasEntry">
                        <Border Width="132" Margin="4" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <Image Source="{x:Bind Image}" Width="72" Height="72" Stretch="Uniform" />
                                <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Category}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind QuantityText}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <StackPanel x:Name="FruitPanel" Spacing="8" Visibility="Collapsed">
                <toolkit:WrapPanel x:Name="FruitCategories" Orientation="Horizontal" HorizontalSpacing="6" VerticalSpacing="6" />
                <GridView x:Name="FruitItems" Height="400" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemTemplate><DataTemplate x:DataType="sections:AtlasEntry">
                    <Border Width="132" Margin="4" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <Image Source="{x:Bind Image}" Width="72" Height="72" Stretch="Uniform" />
                            <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Category}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind QuantityText}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate></GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <StackPanel x:Name="WildlifePanel" Spacing="8" Visibility="Collapsed">
                <toolkit:WrapPanel x:Name="WildlifeCategories" Orientation="Horizontal" HorizontalSpacing="6" VerticalSpacing="6" />
                <GridView x:Name="WildlifeItems" Height="400" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemTemplate><DataTemplate x:DataType="sections:AtlasEntry">
                        <Border Width="132" Margin="4" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <Image Source="{x:Bind Image}" Width="72" Height="72" Stretch="Uniform" />
                                <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Category}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind QuantityText}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
