                                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock svc:Localized.Key="Common.Open" /></StackPanel>
                                    </Button>
                                    <Button x:Name="PinQuickAccessButton" Click="PinManagedStorageToQuickAccessButton_Click" IsEnabled="{Binding CanInvokeQuickAccessAction}" Style="{StaticResource ActionButtonStyle}" ToolTipService.ToolTip="{Binding PinQuickAccessToolTipText}">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Pin" /><TextBlock Text="{Binding PinQuickAccessButtonText}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="ChangePathButton" Click="ChangeManagedStoragePathButton_Click" Style="{StaticResource ActionButtonStyle}" svc:Localized.ToolTipKey="Settings.ManagedPath.ChangeTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Folder" /><TextBlock svc:Localized.Key="Common.Change" /></StackPanel>
                                    </Button>
                                    <Button x:Name="CleanupStorageButton" Click="CleanupManagedStorageButton_Click" Style="{StaticResource ActionButtonStyle}" svc:Localized.ToolTipKey="Settings.ManagedStorage.ManageTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Setting" /><TextBlock svc:Localized.Key="Settings.ManagedStorage.Manage" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.ManagedPath.DesktopShortcut.Description"
                            svc:Localized.HeaderKey="Settings.ManagedPath.DesktopShortcut.Title">
                            <ToggleSwitch
                                x:Name="ManagedStorageDesktopShortcutToggle"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="ManagedStorageDesktopShortcutToggle_Toggled" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="FileStackSettingsSectionTemplate" x:DataType="fileStack:FileStackSettingsViewModel">
