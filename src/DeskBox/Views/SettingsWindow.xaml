<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:sections="using:DeskBox.Views.SettingsSections"
    xmlns:viewModels="using:DeskBox.ViewModels"
    xmlns:fileStack="using:DeskBox.Features.FileStack"
    xmlns:featureWidgets="using:DeskBox.Features.FeatureWidgets"
    xmlns:backup="using:DeskBox.Features.Backup"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SltBox Settings">

    <Grid
        x:Name="SettingsRoot"
        MinWidth="800"
        MinHeight="560"
        IsTabStop="True"
        Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="NavigationViewCompactPaneLength">58</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">42</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">22</x:Double>
            <Thickness x:Key="NavigationViewItemOnLeftIconBoxMargin">0</Thickness>
            <Thickness x:Key="NavigationViewItemButtonMargin">4,1,4,1</Thickness>

            <!-- Shared settings-page metrics keep top-level and drill-down pages aligned. -->
            <controls:SettingsBoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
            <controls:SettingsColorStringConverter x:Key="SettingsColorStringConverter" />
            <x:Double x:Key="SettingsContentMaxWidth">760</x:Double>
            <x:Double x:Key="SettingsRowColumnSpacing">18</x:Double>
			
            <Style x:Key="BreadcrumbTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
			
            <Style x:Key="SettingsNavImageIconStyle" TargetType="ImageIcon">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
            </Style>
			
            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Tag" Value="SettingRow" />
                <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
                <Setter Property="ColumnSpacing" Value="{StaticResource SettingsRowColumnSpacing}" />
                <Setter Property="RowSpacing" Value="8" />
            </Style>
			
            <Style x:Key="SettingTextPanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
			
            <Style x:Key="SettingDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="InlineMetricSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Width" Value="300" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
            </Style>

            <Style x:Key="SliderSettingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingValueTextStyle}">
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="128" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactTextActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                x:Name="TitleTextHost"
                Margin="18,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center">
                    <Image.Source>
                        <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                    </Image.Source>
                </Image>
<TextBlock
VerticalAlignment="Center"
FontSize="14"
FontWeight="SemiBold"
Text="SltBox" />
</StackPanel>

            <AutoSuggestBox
                x:Name="SettingsSearchBox"
                Width="460"
                MinWidth="260"
                MaxWidth="520"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                CornerRadius="16"
                QueryIcon="Find"
                QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                TextChanged="SettingsSearchBox_TextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{Binding Breadcrumb}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <Border
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.18" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="1"
            CompactPaneLength="58"
            IsBackButtonVisible="Visible"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="224"
            PaneDisplayMode="Left"
            BackRequested="SettingsNavigationView_BackRequested"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavItem"
                    Tag="General"
                    svc:Localized.Key="Settings.Nav.General">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/general.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="BackpackNavItem"
                    Tag="Backpack"
                    Visibility="Collapsed"
                    svc:Localized.Key="Settings.Nav.Backpack">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AquariumStoreNavItem"
                    Tag="AquariumStore"
                    Visibility="Collapsed"
                    svc:Localized.Key="Aquarium.Settings.Store">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="Appearance"
                    svc:Localized.Key="Settings.Nav.Appearance">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/appearance.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CapsuleModeNavItem"
                    Tag="CapsuleMode"
                    svc:Localized.Key="Settings.Nav.CapsuleMode">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/capsule-mode.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="FileWidgetNavItem"
                    Tag="AppearanceDetail"
                    svc:Localized.Key="Settings.Nav.FileWidget">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/file-widget.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="FeatureWidgetsNavItem"
                    Tag="FeatureWidgets"
                    svc:Localized.Key="Settings.Nav.FeatureWidgets">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/feature-widgets.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="Interaction"
                    svc:Localized.Key="Settings.Nav.Interaction">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/interaction.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="Maintenance"
                    svc:Localized.Key="Settings.Nav.Maintenance">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/maintenance.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AdminNavItem"
                    Tag="Admin"
                    Visibility="Collapsed"
                    svc:Localized.Key="Settings.Nav.Admin">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavItem"
                    Tag="About"
                    svc:Localized.Key="Settings.Nav.About">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.UpdateReminderBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/about.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
			</NavigationView.MenuItems>

            <Grid x:Name="SettingsContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="PageScroller"
                    Grid.Row="0"
                    Padding="20,16,20,38"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="ContentHost"
                        Width="{StaticResource SettingsContentMaxWidth}"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <StackPanel.Resources>
                    <DataTemplate x:Key="AppearanceSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:AppearanceSettingsSection x:Name="AppearanceSection" Visibility="Collapsed" NavigationRequested="SettingsSection_NavigationRequested" />
                    </DataTemplate>
                    <DataTemplate x:Key="AppearanceMaterialSettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="AppearanceMaterialSettingsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{Binding Windows10Compatibility}"
                            Message="{Binding Windows10CompatibilityMessage}"
                            Severity="Informational"
                            Title="{Binding Windows10CompatibilityTitle}" />
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Material.GroupDescription"
                            svc:Localized.HeaderKey="Settings.Material.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableMaterialTypeOptions}"
                                controls:SettingsComboBox.Value="{Binding MaterialType, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Visibility="{Binding ShowOpacitySlider, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.Opacity.Description"
                                    svc:Localized.HeaderKey="Settings.Opacity.Title">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding WidgetOpacityValueText}" />
                                        <Slider
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.02"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding WidgetTransparency, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Visibility="{Binding ShowMaterialIntensitySlider, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.MaterialIntensity.Description"
                                    svc:Localized.HeaderKey="Settings.MaterialIntensity.Title">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding MaterialIntensityValueText}" />
                                        <Slider
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.02"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding MaterialIntensity, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.WidgetForeground.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetForeground.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableForegroundModeOptions}"
                                        controls:SettingsComboBox.Value="{Binding ForegroundMode, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Visibility="{Binding ShowForegroundCustomColor, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.WidgetForeground.CustomColor.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetForeground.CustomColor.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE2B1;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <toolkit:ColorPickerButton
                                        Width="72"
                                        Height="34"
                                        MinWidth="72"
                                        HorizontalAlignment="Right"
                                        SelectedColor="{Binding ForegroundColorHex, Mode=TwoWay, Converter={StaticResource SettingsColorStringConverter}}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.TextShadow.Description"
                                    svc:Localized.HeaderKey="Settings.TextShadow.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        IsOn="{Binding WidgetTextShadowEnabled, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsExpander
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.WidgetBackground.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetBackground.Title">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE91B;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.HeaderKey="Settings.WidgetBackground.Mode.Title">
                                            <ComboBox
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableWidgetBackgroundModeOptions}"
                                                controls:SettingsComboBox.Value="{Binding WidgetBackgroundMode, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            Visibility="{Binding ShowImageBackgroundOptions, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                            svc:Localized.DescriptionKey="Settings.WidgetBackground.Image.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetBackground.Image.Title">
                                            <Button
                                                Click="ChooseWidgetBackgroundImage_Click"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="OpenFile" />
                                                    <TextBlock svc:Localized.Key="Widget.CustomBackground.ChooseImage" />
                                                </StackPanel>
                                            </Button>
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            Visibility="{Binding ShowUnifiedBackgroundOptions, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                            svc:Localized.HeaderKey="Settings.WidgetBackground.Fit.Title">
                                            <ComboBox
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableWidgetBackgroundUnifiedFitOptions}"
                                                controls:SettingsComboBox.Value="{Binding WidgetBackgroundUnifiedFit, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            Visibility="{Binding ShowImageBackgroundOptions, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                            svc:Localized.HeaderKey="Settings.WidgetBackground.Dim.Title">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding WidgetBackgroundDimValueText}" />
                                                <Slider
                                                    Maximum="100"
                                                    Minimum="0"
                                                    StepFrequency="5"
                                                    Style="{StaticResource InlineMetricSliderStyle}"
                                                    Value="{Binding WidgetBackgroundDimPercent, Mode=TwoWay}"
                                                    ManipulationMode="TranslateX"
                                                    ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                                    ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                                    ValueChanged="AppearanceSlider_ValueChanged"
                                                    PointerPressed="AppearanceSlider_PointerPressed"
                                                    PointerReleased="AppearanceSlider_PointerReleased"
                                                    LostFocus="AppearanceSlider_LostFocus" />
                                            </StackPanel>
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetBackground.PerWidget.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetBackground.PerWidget.Title">
                                            <Button
                                                Click="ClearPerWidgetBackgroundsButton_Click"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <SymbolIcon Symbol="Delete" />
                                                    <TextBlock svc:Localized.Key="Settings.WidgetBackground.PerWidget.Clear" />
                                                </StackPanel>
                                            </Button>
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.BorderColor.Description"
                                    svc:Localized.HeaderKey="Settings.BorderColor.Title">
                                    <ComboBox
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableBorderColorModeOptions}"
                                        controls:SettingsComboBox.Value="{Binding BorderColorMode, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding IsBorderStyleEnabled}"
                                    svc:Localized.DescriptionKey="Settings.Border.Description"
                                    svc:Localized.HeaderKey="Settings.Border.Title">
                                    <ComboBox
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableBorderStyleOptions}"
                                        controls:SettingsComboBox.Value="{Binding BorderStyle, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding NativeCornersSupported}"
                                    svc:Localized.DescriptionKey="Settings.Corner.Description"
                                    svc:Localized.HeaderKey="Settings.Corner.Title">
                                    <ComboBox
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableCornerPreferenceOptions}"
                                        controls:SettingsComboBox.Value="{Binding CornerPreference, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="AppearanceDensitySettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="AppearanceDensitySettingsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Density.Description"
                            svc:Localized.HeaderKey="Settings.Density.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableLayoutDensityOptions}"
                                controls:SettingsComboBox.Value="{Binding LayoutDensity, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.Density.Scale.Description"
                                    svc:Localized.HeaderKey="Settings.Density.Scale.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding LayoutDensityValueText}" />
                                        <Slider
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.02"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding LayoutDensityScale, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Settings.TextSize.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding TextSizeValueText}" />
                                        <Slider
                                            Maximum="16"
                                            Minimum="10"
                                            StepFrequency="0.5"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding TextSize, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Settings.IconSize.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding IconSizeValueText}" />
                                        <Slider
                                            Maximum="56"
                                            Minimum="24"
                                            StepFrequency="2"
                                            Style="{StaticResource InlineMetricSliderStyle}"
