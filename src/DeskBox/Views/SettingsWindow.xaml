                            svc:Localized.HeaderKey="Settings.FileStacks.OpenMode.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7E7;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{x:Bind AvailableOpenModeOptions, Mode=OneWay}"
                                controls:SettingsComboBox.Value="{x:Bind OpenMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            IsEnabled="{Binding StacksEnabled}"
