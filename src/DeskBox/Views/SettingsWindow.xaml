                                <FontIcon Glyph="&#xE9D9;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding RuntimeSummaryText}" />
                                <TextBlock
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding RuntimeDetailText}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="ExportDiagnosticsButton"
                                        Click="ExportDiagnosticsButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.Diagnostics.ExportTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Save" />
                                            <TextBlock svc:Localized.Key="Settings.Diagnostics.Export" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="ResyncRuntimeStateButton_Click"
                                        IsEnabled="{Binding CanResyncRuntime}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.RuntimeHealth.ResyncTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock svc:Localized.Key="Settings.RuntimeHealth.Resync" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="AdminSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:AdminSettingsSection x:Name="AdminSection" Visibility="Collapsed" />
                    </DataTemplate>
                    <DataTemplate x:Key="AboutSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="AboutSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" svc:Localized.Key="Settings.Section.About" />
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="14">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Top">
                                        <Image.Source>
                                            <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                                        </Image.Source>
                                    </Image>
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="SltBox"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding AppVersion}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SettingDescriptionTextStyle}"
                                            svc:Localized.Key="Settings.About.Description" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsExpander
                            HorizontalAlignment="Stretch"
                            IsExpanded="True"
                            svc:Localized.DescriptionKey="Settings.Update.Description"
                            svc:Localized.HeaderKey="Settings.Update.Title">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE895;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Right"
                                svc:Localized.DescriptionKey="Settings.Update.AutoCheckDescription"
                                svc:Localized.HeaderKey="Settings.Update.AutoCheck"
                                Visibility="{Binding UpdateAutoCheckVisibility}">
                                <ToggleSwitch
                                    VerticalAlignment="Center"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    IsOn="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Right"
                                Description="{Binding UpdateStatusText}"
                                svc:Localized.HeaderKey="Settings.Update.Status">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="SkipUpdateVersionButton_Click"
                                        IsEnabled="{Binding IsOneClickActionEnabled}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding SkipUpdateVersionVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                            <TextBlock Text="{Binding SkipUpdateVersionText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OneClickUpdateButton"
                                        VerticalAlignment="Center"
                                        Click="OneClickUpdateButton_Click"
                                        IsEnabled="{Binding IsOneClickActionEnabled}"
                                        Style="{StaticResource ActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE895;" />
                                            <TextBlock Text="{Binding OneClickActionButtonText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Stretch"
                                svc:Localized.HeaderKey="Settings.Update.Details">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <Button
                                        x:Name="ViewReleaseNotesButton"
                                        HorizontalAlignment="Right"
                                        Click="ViewReleaseNotesButton_Click"
                                        IsEnabled="{Binding CanViewReleaseNotes}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="{Binding ReleaseNotesButtonVisibility}"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                            <TextBlock Text="{Binding ViewReleaseNotesButtonText}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Style="{StaticResource SettingDescriptionTextStyle}"
                                        Text="{Binding UpdateDetailText}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="14,10"
                                        Click="ViewReleaseNotesButton_Click"
                                        IsEnabled="{Binding CanViewReleaseNotes}"
                                        AutomationProperties.Name="{Binding ViewReleaseNotesButtonText}"
                                        Visibility="{Binding UpdateSummaryVisibility}">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{Binding UpdateSummaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </Button>

                                    <StackPanel Spacing="6" Visibility="{Binding UpdateProgressVisibility}">
                                        <ProgressBar
                                            Height="4"
                                            Minimum="0"
                                            Maximum="100"
                                            IsIndeterminate="{Binding UpdateProgressIsIndeterminate}"
                                            Value="{Binding UpdateProgressValue}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SettingDescriptionTextStyle}"
                                            Text="{Binding UpdateProgressText}"
                                            TextAlignment="Right"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="UpdateActionsPanel"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{Binding UpdateFallbackVisibility}">
                                        <Button
                                            x:Name="OpenManualUpdateDownloadButton"
                                            Click="OpenManualUpdateDownloadButton_Click"
                                            IsEnabled="{Binding CanOpenUpdateFallback}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            ToolTipService.ToolTip="{Binding ManualUpdateDownloadUrl}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                                <TextBlock Text="{Binding UpdateFallbackActionText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                </StackPanel.Resources>
                <Grid
                    x:Name="SettingsBreadcrumbHost"
                    Visibility="Collapsed">
                    <BreadcrumbBar
                        x:Name="SettingsBreadcrumbBar"
                        HorizontalAlignment="Left"
                        ItemClicked="SettingsBreadcrumbBar_ItemClicked"
                        Visibility="Collapsed">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Style="{StaticResource BreadcrumbTextStyle}"
                                    Opacity="{Binding Opacity}"
                                    Text="{Binding Title}" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                </Grid>

                <StackPanel
                    x:Name="GeneralSection"
                    Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" svc:Localized.Key="Settings.Section.General" />
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="Settings.Account.SyncBenefit"
                            svc:Localized.HeaderKey="Settings.Account.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE77B;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Grid MinWidth="320">
                                <StackPanel
                                    Spacing="8"
                                    Visibility="{Binding AccountSignedOutVisibility}">
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Account.Username" />
                                    <TextBox
                                        x:Name="AccountUsernameTextBox"
                                        IsEnabled="{Binding AccountActionsEnabled}"
                                        MaxLength="32"
                                        Text="{Binding AccountUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Account.Password" />
                                    <PasswordBox
                                        x:Name="AccountPasswordBox"
                                        IsEnabled="{Binding AccountActionsEnabled}"
                                        MaxLength="128" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="AccountSignInButton"
                                            Click="AccountSignInButton_Click"
                                            IsEnabled="{Binding AccountActionsEnabled}"
                                            Style="{StaticResource ActionButtonStyle}">
                                            <TextBlock svc:Localized.Key="Settings.Account.SignIn" />
                                        </Button>
                                        <Button
                                            x:Name="AccountRegisterButton"
                                            Click="AccountRegisterButton_Click"
                                            IsEnabled="{Binding AccountActionsEnabled}"
                                            Style="{StaticResource ActionButtonStyle}">
                                            <TextBlock svc:Localized.Key="Settings.Account.Register" />
                                        </Button>
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            IsActive="{Binding IsAccountBusy}"
                                            Visibility="{Binding IsAccountBusy, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource SettingDescriptionTextStyle}"
                                        Text="{Binding AccountStatusText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding AccountStatusVisibility}" />
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Visibility="{Binding AccountSignedInVisibility}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingDescriptionTextStyle}"
                                        Text="{Binding AccountSignedInText}" />
                                    <Button
                                        x:Name="AccountSignOutButton"
                                        Click="AccountSignOutButton_Click"
                                        IsEnabled="{Binding AccountActionsEnabled}"
                                        Style="{StaticResource ActionButtonStyle}">
                                        <TextBlock svc:Localized.Key="Settings.Account.SignOut" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.HeaderKey="Settings.DingTalk.Title"
                            svc:Localized.DescriptionKey="Settings.DingTalk.Description"
                            ContentAlignment="Left">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Glyph="&#xE71B;"
                                    IsHitTestVisible="False" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingTitleTextStyle}"
                                    svc:Localized.Key="Settings.DingTalk.Title" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    svc:Localized.Key="Settings.DingTalk.Description" />
                                <TextBlock
                                    Grid.Column="3"
                                    MaxWidth="160"
                                    VerticalAlignment="Center"
                                    Text="{Binding DingTalkStatusText}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                    <Button Click="DingTalkLink_Click" IsEnabled="{Binding DingTalkActionsEnabled}" Visibility="{Binding DingTalkLinkVisibility}" svc:Localized.Key="Settings.DingTalk.Link" />
                                    <Button Click="DingTalkRefresh_Click" IsEnabled="{Binding DingTalkActionsEnabled}" Visibility="{Binding DingTalkLinkedVisibility}" svc:Localized.Key="Settings.DingTalk.Refresh" />
                                    <Button Click="DingTalkUnlink_Click" IsEnabled="{Binding DingTalkActionsEnabled}" Visibility="{Binding DingTalkLinkedVisibility}" svc:Localized.Key="Settings.DingTalk.Unlink" />
                                    <ProgressRing Width="16" Height="16" IsActive="{Binding IsDingTalkBusy}" Visibility="{Binding IsDingTalkBusy, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Language.Description"
                            svc:Localized.HeaderKey="Settings.Language.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableLanguageOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedLanguage, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.AttachmentStorageMode.Description"
                            svc:Localized.HeaderKey="Settings.AttachmentStorageMode.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE723;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="AttachmentStorageModeComboBox"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableAttachmentStorageModeOptions}"
                                controls:SettingsComboBox.Value="{Binding AttachmentStorageMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                                <Button
                                    Grid.Column="0"
                                    Click="NestedSettingsButton_Click"
                                    Style="{StaticResource DrillDownRowStyle}"
                                    Tag="PerformanceSettings">
                                    <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE945;" IsHitTestVisible="False" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Performance.Title" />
                                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" svc:Localized.Key="Settings.Performance.Description" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <ComboBox
                                    x:Name="PerformanceModeInlineComboBox"
                                    Grid.Column="1"
                                    MinWidth="176"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding AvailablePerformanceModeOptions}"
                                    controls:SettingsComboBox.Value="{Binding SelectedPerformanceMode, Mode=TwoWay}" />
                                <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.AutoStart.Description"
                            svc:Localized.HeaderKey="Settings.AutoStart.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C1;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding AutoStart, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.HeaderKey="Settings.AutoStart.Mode.Title"
                            svc:Localized.DescriptionKey="Settings.AutoStart.Mode.Description"
                            Visibility="{Binding AutoStartModeVisibility}">
                            <ComboBox
                                MinWidth="176"
                                ItemsSource="{Binding AvailableAutoStartModeOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedAutoStartMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Header="{Binding AutoStartStatusText}"
                            HorizontalContentAlignment="Right"
                            Visibility="{Binding AutoStartStatusVisibility}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7BA;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="OpenStartupAppsSettingsButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{Binding AutoStartSystemSettingsVisibility}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                                    <TextBlock svc:Localized.Key="Settings.AutoStart.OpenSystemSettings" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.SilentStartup.Description"
                            svc:Localized.HeaderKey="Settings.SilentStartup.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7B3;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding SilentStartup, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Onboarding.Description"
                            svc:Localized.HeaderKey="Settings.Onboarding.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE82D;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="ShowOnboardingButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.Onboarding.Tooltip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE82D;" />
                                    <TextBlock svc:Localized.Key="Common.View" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

    </Grid>
</Window>
